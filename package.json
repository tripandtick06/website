{
  "name": "tripandtick",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "npx tsx scripts/indexnow-postbuild.ts",
    "start": "next start",
    "psi": "node scripts/psi-audit.cjs",
    "validate:hreflang": "node scripts/validate-hreflang.cjs",
    "check:seo": "node scripts/seo-guards.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "next lint",
    "seo-agent": "npx tsx scripts/seo-agent.ts",
    "seo-agent:daily": "npx tsx scripts/seo-agent.ts --daily",
    "build:cf": "npx @cloudflare/next-on-pages",
    "preview:cf": "npm run build:cf && npx wrangler pages dev .vercel/output/static",
    "deploy:cf": "npm run build:cf && npx wrangler pages deploy .vercel/output/static --project-name=tripandtick"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@stripe/stripe-js": "^4.0.0",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "next-intl": "^3.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stripe": "^16.0.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "p-limit": "^7.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "eslintConfig": {
    "extends": [
      "next/core-web-vitals"
    ],
    "rules": {
      "@next/next/no-img-element": "warn",
      "react/no-unescaped-entities": "off",
      "react-hooks/exhaustive-deps": "warn"
    },
    "ignorePatterns": [
      ".next/",
      "node_modules/",
      "out/",
      "build/",
      "dist/",
      ".vercel/",
      ".wrangler/",
      "coverage/",
      "public/",
      "scripts/**/*.cjs",
      "scripts/**/*.mjs"
    ]
  }
}

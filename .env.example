# Trip and Tick - Environment Variables
# Copy this to .env.local and fill in your values
# Production: Cloudflare Pages dashboard - Settings - Environment Variables
# Detail: ENV-CHECKLIST.md + DEPLOY-RUNBOOK.md

# Site
NEXT_PUBLIC_SITE_URL=https://www.tripandtick.com
NEXT_PUBLIC_DEFAULT_LOCALE=tr
NEXT_PUBLIC_IYZICO_ENABLED=false

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# iyzico (su an passive — onay sonrasi)
IYZICO_API_KEY=
IYZICO_SECRET=
IYZICO_BASE_URL=https://api.iyzipay.com

# Admin
ADMIN_API_TOKEN=
NEXT_PUBLIC_ADMIN_TOKEN=
ADMIN_EMAIL=info@tripandtick.com

# Reschedule magic-link (HMAC)
RESCHEDULE_SECRET=

# Brevo (transactional + magic-link)
BREVO_API_KEY=xkeysib-...
BREVO_FROM_EMAIL=hello@tripandtick.com
BREVO_FROM_NAME=Trip and Tick
BREVO_TO_EMAIL=

# Supabase (yoksa in-memory fallback restart-data-loss)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
ANTHROPIC_API_KEY=sk-ant-api03-...
GOOGLE_AI_API_KEY=AIza...

# Cron + SEO
CRON_SECRET=
SEO_AGENT_CRON=0 3 * * *
SEO_AGENT_AUTO_PUBLISH=false

# IndexNow (opsiyonel)
INDEXNOW_KEY=

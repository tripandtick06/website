# Trip and Tick - Environment Variables
# Copy this to .env.local and fill in your values

# 21st.dev API (UI Component Generation)
NEXT_PUBLIC_21STDEV_API_KEY=your_21stdev_api_key_here

# Claude AI API (SEO Agent & Content Generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# iyzico Payment (Turkey)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=re_...

# SMS (Netgsm)
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=TRIPANDTICK

# Site
NEXT_PUBLIC_SITE_URL=https://tripandtick.com
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# SEO Agent
SEO_AGENT_CRON=0 3 * * *
SEO_AGENT_AUTO_PUBLISH=false

# Trip and Tick — .env.local TEMPLATE
# -----------------------------------------------------------------------------
# SECURITY NOTE
# -----------------------------------------------------------------------------
# 1. Bu dosya .gitignore'da DEGIL — yapi olarak guvenli (gercek key icermez).
# 2. Gercek key'leri sadece `.env.local` veya `.env`'e koy — ASLA bu template'e.
# 3. Anthropic API key: scoped olarak olustur (orn `tripandtick-seo-{TIMESTAMP}`)
#    ve sadece `claude-sonnet-4.6` / `claude-haiku-4.5` modellerine izin ver.
# 4. Stripe webhook secret rotate edildiginde Vercel env'i de guncelle.
# 5. Production deploy oncesi tum *_test_* keylerini live versiyonla degistir.
# -----------------------------------------------------------------------------

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://www.tripandtick.com
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# ---------- AI (Anthropic) ----------
# Key isim formati: tripandtick-seo-{TIMESTAMP}  (orn tripandtick-seo-20260515)
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_SCOPED_KEY

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# ---------- Supabase (Faz 2) ----------
# 1. https://supabase.com/dashboard -> "New project"
# 2. Settings -> API: Project URL + anon/public key + service_role key
# 3. SQL Editor: paste supabase/migrations/0001_initial_schema.sql + (opt) supabase/seed.sql
# 4. Env yokken kod mock-fallback (mock-bookings.ts + availability-store.ts) ile calisir.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...REPLACE
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...REPLACE_SERVER_ONLY_BYPASS_RLS

# ---------- Email (Brevo aktif — Resend kaldirildi) ----------
# Brevo transactional + magic-link batch.
# Production: BREVO_FROM_EMAIL DKIM verify edilmis domain olmali (hello@tripandtick.com).
BREVO_API_KEY=xkeysib-...
BREVO_FROM_EMAIL=hello@tripandtick.com
BREVO_FROM_NAME=Trip and Tick
BREVO_TO_EMAIL=info@tripandtick.com
ADMIN_EMAIL=info@tripandtick.com

# ---------- Admin Panel ----------
# openssl rand -hex 32 cikti, NEXT_PUBLIC_ADMIN_TOKEN ile ayni deger ol.
ADMIN_API_TOKEN=REPLACE_WITH_HEX32
NEXT_PUBLIC_ADMIN_TOKEN=REPLACE_WITH_SAME_HEX32

# ---------- Reschedule magic-link ----------
# openssl rand -hex 32. Yoksa ADMIN_API_TOKEN fallback.
RESCHEDULE_SECRET=REPLACE_WITH_HEX32

# ---------- Cron ----------
CRON_SECRET=REPLACE_WITH_HEX32

# ---------- SMS (Netgsm) ----------
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=TRIPANDTICK

# ---------- SEO ops ----------
SEO_AGENT_CRON=0 3 * * *
SEO_AGENT_AUTO_PUBLISH=false
GOOGLE_PSI_KEY=REPLACE_WITH_PSI_KEY
INDEXNOW_KEY=REPLACE_WITH_INDEXNOW_KEY

# ---------- Admin demo ----------
ADMIN_DEMO_USER=demo@tripandtick.com
ADMIN_DEMO_PASS=REPLACE_STRONG_PASSWORD

# ---------- Analytics ----------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_HOTJAR_SV=6

# ---------- Sentry (Error tracking) ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Google Maps (opsiyonel) ----------
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---------- Search Engine Verification (lansman gereği) ----------
# Google Search Console — HTML tag verification (sadece content kismi, "google-site-verification=" prefiks YOK)
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools — content="..." kismi
NEXT_PUBLIC_BING_VERIFICATION=
# Yandex Webmaster — content="..." kismi
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Baidu Webmaster (Çince pazar — Faz 3)
NEXT_PUBLIC_BAIDU_VERIFICATION=

    {
      "type": "jsxText",
      "tr": "İade Tutarı",
      "rawStart": 3038,
      "rawEnd": 3049,
      "textStart": 3038,
      "textEnd": 3049,
      "line": 74,
      "col": 79,
      "context": "jsx",

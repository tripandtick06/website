      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "1. Müşteri Kaynaklı İptal",
      "rawStart": 3616,
      "rawEnd": 3665,
      "textStart": 3629,
      "textEnd": 3654,
      "line": 88,
      "col": 76,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "Plan değişikliği, kişisel nedenler veya başka herhangi bir sebeple\n            rezervasyonunuzu iptal etmek istiyorsanız aşağıdaki kurallar uygulanır:",
      "rawStart": 3732,
      "rawEnd": 3906,
      "textStart": 3745,
      "textEnd": 3895,
      "line": 91,
      "col": 61,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "72 saat ve daha öncesinden iptal:",
      "rawStart": 4007,
      "rawEnd": 4040,
      "textStart": 4007,
      "textEnd": 4040,
      "line": 96,
      "col": 24,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Ödediğiniz tutarın %100'ü iade edilir.",
      "rawStart": 4049,
      "rawEnd": 4088,
      "textStart": 4050,
      "textEnd": 4088,
      "line": 96,
      "col": 66,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": " ",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "24 ile 72 saat arası iptal:",
      "rawStart": 4118,
      "rawEnd": 4145,
      "textStart": 4118,
      "textEnd": 4145,
      "line": 97,
      "col": 24,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Ödediğiniz tutarın %50'si iade edilir.",
      "rawStart": 4154,
      "rawEnd": 4193,
      "textStart": 4155,
      "textEnd": 4193,
      "line": 97,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": " ",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "24 saatten az iptal:",
      "rawStart": 4223,
      "rawEnd": 4243,
      "textStart": 4223,
      "textEnd": 4243,
      "line": 98,
      "col": 24,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "İade hakkı yoktur. (Sağlık raporu istisnası için aşağıya bakın.)",
      "rawStart": 4252,
      "rawEnd": 4317,
      "textStart": 4253,
      "textEnd": 4317,
      "line": 98,
      "col": 53,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": " ",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "2. Hava ve Operatör Kaynaklı İptal",
      "rawStart": 4416,
      "rawEnd": 4474,
      "textStart": 4429,
      "textEnd": 4463,
      "line": 101,
      "col": 76,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "Operatör iptali (rüzgar >25 km/sa, görüş azalması, yağış, teknik\n                  arıza vb.) durumunda iptal sizden değil bizden kaynaklandığı için\n                  ödediğiniz tutarın",
      "rawStart": 4862,
      "rawEnd": 5070,
      "textStart": 4881,
      "textEnd": 5069,
      "line": 109,
      "col": 70,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n                  ",
      "trailing": " "
    },
    {
      "type": "jsxText",
      "tr": ". Alternatif\n                  olarak tarih değişikliği yapılabilir; bu durumda ek ücret alınmaz.",
      "rawStart": 5105,
      "rawEnd": 5219,
      "textStart": 5105,
      "textEnd": 5202,
      "line": 112,
      "col": 72,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": "\n                "
    },
    {
      "type": "jsxText",
      "tr": "3. Sağlık Raporu İstisnası",
      "rawStart": 5358,
      "rawEnd": 5408,
      "textStart": 5371,
      "textEnd": 5397,
      "line": 119,
      "col": 76,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "Rezervasyon sonrası ortaya çıkan hastalık, kaza veya hamilelik gibi\n            durumlarda",
      "rawStart": 5475,
      "rawEnd": 5579,
      "textStart": 5488,
      "textEnd": 5578,
      "line": 122,
      "col": 61,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": " "
    },
    {
      "type": "jsxText",
      "tr": "resmi sağlık raporu",
      "rawStart": 5587,
      "rawEnd": 5606,
      "textStart": 5587,
      "textEnd": 5606,
      "line": 124,
      "col": 31,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "ibrazıyla %100 iade yapılır.\n            Raporun rezervasyon tarihinden sonra düzenlenmiş olması gerekir.",
      "rawStart": 5615,
      "rawEnd": 5732,
      "textStart": 5616,
      "textEnd": 5721,
      "line": 124,
      "col": 59,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": " ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "4. Geç Gelme / No-Show",
      "rawStart": 5814,
      "rawEnd": 5860,
      "textStart": 5827,
      "textEnd": 5849,
      "line": 128,
      "col": 76,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "Buluşma noktasında belirlenen saatte hazır olmamanız durumunda iade hakkı\n              yoktur. Otelden transfer alma saatini en az 24 saat önceden onaylamanızı\n              öneririz.",
      "rawStart": 6107,
      "rawEnd": 6319,
      "textStart": 6122,
      "textEnd": 6306,
      "line": 133,
      "col": 66,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n              ",
      "trailing": "\n            "
    },
    {
      "type": "jsxText",
      "tr": "5. İade Süresi & Yöntemi",
      "rawStart": 6418,
      "rawEnd": 6466,
      "textStart": 6431,
      "textEnd": 6455,
      "line": 140,
      "col": 76,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "İade onaylandıktan sonra",
      "rawStart": 6560,
      "rawEnd": 6585,
      "textStart": 6560,
      "textEnd": 6584,
      "line": 144,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": " "
    },
    {
      "type": "jsxText",
      "tr": "5-10 iş günü",
      "rawStart": 6593,
      "rawEnd": 6605,
      "textStart": 6593,
      "textEnd": 6605,
      "line": 144,
      "col": 49,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "içinde ödeme yapılan karta geri yatırılır.",
      "rawStart": 6614,
      "rawEnd": 6657,
      "textStart": 6615,
      "textEnd": 6657,
      "line": 144,
      "col": 70,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": " ",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Bankaların iade yansıma süresi 2-7 iş günü daha sürebilir.",
      "rawStart": 6679,
      "rawEnd": 6737,
      "textStart": 6679,
      "textEnd": 6737,
      "line": 145,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "İade tutarı orijinal ödeme yöntemine yapılır; başka karta aktarılamaz.",
      "rawStart": 6759,
      "rawEnd": 6829,
      "textStart": 6759,
      "textEnd": 6829,
      "line": 146,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "6. İptal Talebi Nasıl Yapılır?",
      "rawStart": 6928,
      "rawEnd": 6982,
      "textStart": 6941,
      "textEnd": 6971,
      "line": 149,
      "col": 76,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "info@tripandtick.com — rezervasyon no + iptal sebebi.",
      "rawStart": 7101,
      "rawEnd": 7155,
      "textStart": 7102,
      "textEnd": 7155,
      "line": 153,
      "col": 41,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": " ",
      "trailing": ""
    },
    {

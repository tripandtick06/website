      "rawStart": 7203,
      "rawEnd": 7236,
      "textStart": 7204,
      "textEnd": 7236,
      "line": 154,
      "col": 42,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": " ",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Talep onaylanır onaylanmaz e-posta ile bildirilir.",
      "rawStart": 7258,
      "rawEnd": 7308,
      "textStart": 7258,
      "textEnd": 7308,
      "line": 155,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Adalet Garantisi",
      "rawStart": 7513,
      "rawEnd": 7529,
      "textStart": 7513,
      "textEnd": 7529,
      "line": 160,
      "col": 51,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "İptal politikamız Kapadokya'daki en şeffaf politikalardan biridir. Hava\n              kaynaklı iptallerde komisyon kesintisi yapılmaz, %100 iade verilir. Tek\n              istisna 24 saatten az iptaldir — bu da operatör tarafının iş gücü\n              maliyetini koruma amaçlıdır.",
      "rawStart": 7600,
      "rawEnd": 7908,
      "textStart": 7615,
      "textEnd": 7895,
      "line": 161,
      "col": 65,

      "leading": "",
      "trailing": "\n              "
    },
    {
      "type": "jsxText",
      "tr": "UNESCO Dünya Mirası Listesi'nde",
      "rawStart": 2950,
      "rawEnd": 2982,
      "textStart": 2951,
      "textEnd": 2982,
      "line": 90,
      "col": 22,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": " ",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "bulunan dünyaca ünlü bir\n              tatil destinasyonudur. Milyonlarca yıl önce volkanik patlamalarla şekillenen",
      "rawStart": 2991,
      "rawEnd": 3107,
      "textStart": 2992,
      "textEnd": 3107,
      "line": 90,
      "col": 63,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": " ",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "peri bacaları",
      "rawStart": 3135,
      "rawEnd": 3148,
      "textStart": 3135,
      "textEnd": 3148,
      "line": 92,
      "col": 22,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": ", Bizans dönemine ait kayaya oyma kiliseler ve\n              tarih öncesi yeraltı şehirleri, bölgeyi yılda 4 milyondan fazla turistin\n              ziyaret ettiği bir kültür-doğa merkezi haline getirir.",
      "rawStart": 3157,
      "rawEnd": 3372,
      "textStart": 3157,
      "textEnd": 3359,
      "line": 92,
      "col": 44,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": "\n            "
    },
    {
      "type": "jsxText",
      "tr": "Kapadokya denildiğinde akla ilk gelen",
      "rawStart": 3392,
      "rawEnd": 3444,
      "textStart": 3407,
      "textEnd": 3444,
      "line": 96,
      "col": 15,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n              ",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "sıcak hava balon turlarıdır",
      "rawStart": 3472,
      "rawEnd": 3499,
      "textStart": 3472,
      "textEnd": 3499,
      "line": 98,
      "col": 22,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": ". Gün doğumunda yüzlerce\n              renkli balonun semayı süslediği bu deneyim,",
      "rawStart": 3508,
      "rawEnd": 3590,
      "textStart": 3508,
      "textEnd": 3590,
      "line": 98,
      "col": 58,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "9'dan fazla TÜRSAB lisanslı operatör",
      "rawStart": 3618,
      "rawEnd": 3654,
      "textStart": 3618,
      "textEnd": 3654,
      "line": 100,
      "col": 22,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "tarafından sunulur.\n              Standart €165, Konfor €215, Deluxe €295 ve Romantik özel €580'den başlayan\n              fiyatlar — transfer, kahvaltı, sigorta, sertifika ve şampanya servisi dahil.",
      "rawStart": 3663,
      "rawEnd": 3876,
      "textStart": 3664,
      "textEnd": 3863,
      "line": 100,
      "col": 67,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": " ",
      "trailing": "\n            "
    },
    {
      "type": "jsxText",
      "tr": "Balon dışında ATV turları, at binme deneyimleri, Kırmızı ve Yeşil gezi\n              turları, mağara otel konaklamaları ve yeraltı şehri ziyaretleri ile\n              Kapadokya 2-5 günlük tatil için ideal bir destinasyondur. En iyi ziyaret\n              dönemi",
      "rawStart": 3896,
      "rawEnd": 4172,
      "textStart": 3911,
      "textEnd": 4171,
      "line": 104,
      "col": 15,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n              ",
      "trailing": " "
    },
    {
      "type": "jsxText",
      "tr": "Eylül-Ekim",
      "rawStart": 4214,
      "rawEnd": 4224,
      "textStart": 4214,
      "textEnd": 4224,
      "line": 108,
      "col": 63,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "aralığıdır — balon uçuş oranları %85+ seviyesindedir.",
      "rawStart": 4238,
      "rawEnd": 4319,
      "textStart": 4253,
      "textEnd": 4306,

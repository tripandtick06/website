      "end": 2507,
      "line": 79,
      "col": 20,
      "context": "PageHero@description",
      "nodeType": "StringLiteral"
    },
    {
      "type": "jsxText",
      "tr": "Kapadokya",
      "rawStart": 2862,
      "rawEnd": 2871,
      "textStart": 2862,
      "textEnd": 2871,
      "line": 89,
      "col": 22,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": ", Türkiye'nin İç Anadolu bölgesinde yer alan ve",
      "rawStart": 2880,
      "rawEnd": 2942,
      "textStart": 2880,
      "textEnd": 2927,
      "line": 89,

      "nodeType": "StringLiteral"
    },
    {
      "type": "jsxText",
      "tr": "Yürürlük tarihi: 1 Mayıs 2026 · Son güncelleme: 15 Mayıs 2026",
      "rawStart": 1751,
      "rawEnd": 1836,
      "textStart": 1764,
      "textEnd": 1825,
      "line": 50,

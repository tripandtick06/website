      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "1. Taraflar",
      "rawStart": 1902,
      "rawEnd": 1913,
      "textStart": 1902,
      "textEnd": 1913,
      "line": 54,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Satıcı:",
      "rawStart": 1964,
      "rawEnd": 1985,
      "textStart": 1977,
      "textEnd": 1984,
      "line": 55,
      "col": 45,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": " "
    },
    {
      "type": "jsxText",
      "tr": "Trip and Tick Turizm ve Seyahat Acentası Limited Şirketi",
      "rawStart": 1993,
      "rawEnd": 2049,
      "textStart": 1993,
      "textEnd": 2049,
      "line": 56,
      "col": 28,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "(bundan sonra \"Trip and Tick\"). Adres: Göreme Merkez, Nevşehir 50180. TÜRSAB\n            lisanslı.",
      "rawStart": 2063,
      "rawEnd": 2185,
      "textStart": 2076,
      "textEnd": 2174,
      "line": 56,
      "col": 98,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "Alıcı: tripandtick.com üzerinden hizmet satın alan veya satın almayı taahhüt\n            eden gerçek/tüzel kişi (bundan sonra \"Müşteri\").",
      "rawStart": 2235,
      "rawEnd": 2396,
      "textStart": 2248,
      "textEnd": 2385,
      "line": 60,
      "col": 45,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "2. Hizmet Kapsamı",
      "rawStart": 2462,
      "rawEnd": 2479,
      "textStart": 2462,
      "textEnd": 2479,
      "line": 65,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Trip and Tick, balon turu, otel rezervasyonu, transfer, ATV, at binme, gezi\n            turları ve kombo paketler dahil olmak üzere Kapadokya bölgesindeki turizm\n            hizmetlerini aracılık edici sıfatla satar. Hizmetler, anlaşmalı operatörler\n            tarafından fiilen sunulur; Trip and Tick rezervasyon, ödeme ve müşteri\n            desteği işlemlerini yönetir.",
      "rawStart": 2530,
      "rawEnd": 2927,
      "textStart": 2543,
      "textEnd": 2916,
      "line": 66,
      "col": 45,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "3. Fiyatlandırma & Para Birimleri",
      "rawStart": 2993,
      "rawEnd": 3026,
      "textStart": 2993,
      "textEnd": 3026,
      "line": 74,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Fiyatlar EUR, USD veya TRY cinsinden gösterilir.",
      "rawStart": 3122,
      "rawEnd": 3170,
      "textStart": 3122,
      "textEnd": 3170,
      "line": 76,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Tüm vergiler (KDV dahil) fiyata dahildir.",
      "rawStart": 3192,
      "rawEnd": 3233,
      "textStart": 3192,
      "textEnd": 3233,
      "line": 77,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Çocuk indirimi 7-12 yaş arası uygulanır (paket bazında değişir).",
      "rawStart": 3255,
      "rawEnd": 3319,
      "textStart": 3255,
      "textEnd": 3319,
      "line": 78,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Yüksek sezon (Nisan-Haziran, Eylül-Ekim) ek ücret yansıyabilir.",
      "rawStart": 3341,
      "rawEnd": 3404,
      "textStart": 3341,
      "textEnd": 3404,
      "line": 79,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "En düşük fiyat garantisi: daha ucuz teklif bulursanız %5 altı.",
      "rawStart": 3426,
      "rawEnd": 3488,
      "textStart": 3426,
      "textEnd": 3488,
      "line": 80,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "4. Ödeme",
      "rawStart": 3571,
      "rawEnd": 3579,
      "textStart": 3571,
      "textEnd": 3579,
      "line": 83,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Ödeme; Visa, Mastercard, American Express ve UnionPay ile yapılabilir. 3D\n            Secure aktiftir. Kart bilgileri Trip and Tick'te saklanmaz; PCI-DSS uyumlu\n            ödeme sağlayıcılarına yönlendirilir. Rezervasyon, ödeme onayından sonra\n            kesinleşir; onay e-postası ile birlikte PDF biletiniz iletilir.",
      "rawStart": 3630,
      "rawEnd": 3974,
      "textStart": 3643,
      "textEnd": 3963,
      "line": 84,
      "col": 45,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "5. İptal & İade",
      "rawStart": 4040,
      "rawEnd": 4055,
      "textStart": 4040,
      "textEnd": 4055,
      "line": 91,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "İptal politikamızın tam metni için",
      "rawStart": 4106,
      "rawEnd": 4153,
      "textStart": 4119,
      "textEnd": 4153,
      "line": 92,
      "col": 45,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "İptal & İade Politikası",
      "rawStart": 4261,
      "rawEnd": 4312,
      "textStart": 4276,
      "textEnd": 4299,
      "line": 94,
      "col": 102,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n              ",
      "trailing": "\n            "
    },
    {
      "type": "jsxText",
      "tr": "sayfasına bakın. Özet: 72+ saat önce %100 iade, 24-72 saat %50 iade, 24 saat\n            altı iade yok. Operatör veya hava kaynaklı iptalde her zaman %100 iade veya\n            alternatif tarih.",
      "rawStart": 4324,
      "rawEnd": 4542,
      "textStart": 4337,
      "textEnd": 4531,
      "line": 96,
      "col": 24,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "6. Müşteri Yükümlülükleri",
      "rawStart": 4608,
      "rawEnd": 4633,
      "textStart": 4608,
      "textEnd": 4633,
      "line": 102,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Doğru ad, doğum tarihi ve iletişim bilgisi vermek.",
      "rawStart": 4729,
      "rawEnd": 4779,
      "textStart": 4729,
      "textEnd": 4779,
      "line": 104,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Hamilelik veya ciddi sağlık sorunu varsa rezervasyon öncesi bildirmek.",
      "rawStart": 4801,
      "rawEnd": 4871,
      "textStart": 4801,
      "textEnd": 4871,
      "line": 105,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Yaş ve kilo limitlerine uymak (balon: 6+ yaş).",
      "rawStart": 4893,
      "rawEnd": 4939,
      "textStart": 4893,
      "textEnd": 4939,
      "line": 106,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Buluşma saatinde hazır olmak; gecikme durumunda iade hakkı yoktur.",
      "rawStart": 4961,
      "rawEnd": 5027,
      "textStart": 4961,
      "textEnd": 5027,
      "line": 107,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Operatör güvenlik kurallarına uymak.",
      "rawStart": 5049,
      "rawEnd": 5085,
      "textStart": 5049,
      "textEnd": 5085,
      "line": 108,
      "col": 16,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "7. Sorumluluk Reddi",
      "rawStart": 5168,
      "rawEnd": 5187,
      "textStart": 5168,
      "textEnd": 5187,
      "line": 111,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Trip and Tick, hizmeti fiilen sunan operatörün gerçekleştirdiği uçuş,\n            transfer veya aktivite sırasında oluşan kişisel kazalardan birinci derecede\n            sorumlu değildir; ancak operatörler 40 milyon Euro mali sorumluluk sigortası\n            kapsamındadır. Hava kaynaklı veya zorunlu iptal durumunda iade koşulları\n            uygulanır.",
      "rawStart": 5238,
      "rawEnd": 5616,
      "textStart": 5251,
      "textEnd": 5605,
      "line": 112,
      "col": 45,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "8. Fikri Mülkiyet",
      "rawStart": 5682,
      "rawEnd": 5699,
      "textStart": 5682,
      "textEnd": 5699,
      "line": 120,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Site içeriği (metin, görsel, kod, logo, marka) Trip and Tick'e aittir. Yazılı\n            izin olmadan kopyalanması, yeniden dağıtılması veya ticari amaçla\n            kullanılması yasaktır.",
      "rawStart": 5750,
      "rawEnd": 5964,
      "textStart": 5763,
      "textEnd": 5953,
      "line": 121,
      "col": 45,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "9. Tüketici Hakları",
      "rawStart": 6030,
      "rawEnd": 6049,
      "textStart": 6030,
      "textEnd": 6049,
      "line": 127,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "6502 sayılı Tüketicinin Korunması Hakkında Kanun ve Mesafeli Sözleşmeler\n            Yönetmeliği hükümleri geçerlidir. Tüketici Hakem Heyetleri ve Tüketici\n            Mahkemeleri'ne başvuru hakkınız vardır. Detaylı bilgi için",
      "rawStart": 6100,
      "rawEnd": 6339,
      "textStart": 6113,
      "textEnd": 6339,
      "line": 128,
      "col": 45,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "sayfamıza bakın.",
      "rawStart": 6474,
      "rawEnd": 6514,
      "textStart": 6487,
      "textEnd": 6503,
      "line": 134,
      "col": 24,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "10. Uyuşmazlık Çözümü",
      "rawStart": 6580,
      "rawEnd": 6601,
      "textStart": 6580,
      "textEnd": 6601,
      "line": 138,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Uyuşmazlık halinde öncelikle Trip and Tick müşteri desteğine başvuru yapın.\n            Çözüm bulunamazsa Nevşehir Tüketici Hakem Heyeti veya Nevşehir Tüketici\n            Mahkemeleri yetkilidir. Uygulanacak hukuk Türk hukukudur.",
      "rawStart": 6652,
      "rawEnd": 6905,
      "textStart": 6665,
      "textEnd": 6894,
      "line": 139,
      "col": 45,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "11. Değişiklikler",
      "rawStart": 6971,
      "rawEnd": 6988,
      "textStart": 6971,
      "textEnd": 6988,
      "line": 145,
      "col": 60,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Trip and Tick bu şartları zaman zaman güncelleyebilir. Güncel versiyon\n            tripandtick.com/kullanim-sartlari adresinde yayımlanır; kullanıma devam etmek\n            güncel şartların kabulü anlamına gelir.",
      "rawStart": 7039,
      "rawEnd": 7275,
      "textStart": 7052,
      "textEnd": 7264,
      "line": 146,
      "col": 45,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "\n            ",
      "trailing": "\n          "
    },
    {
      "type": "jsxText",
      "tr": "İletişim",
      "rawStart": 7431,
      "rawEnd": 7439,
      "textStart": 7431,
      "textEnd": 7439,
      "line": 153,
      "col": 65,
      "context": "jsx",
      "nodeType": "JSXText",
      "leading": "",
      "trailing": ""
    },
    {
      "type": "jsxText",
      "tr": "Sorularınız için:",
      "rawStart": 7494,
      "rawEnd": 7526,
      "textStart": 7509,
      "textEnd": 7526,
      "line": 154,
      "col": 50,
      "context": "jsx",
